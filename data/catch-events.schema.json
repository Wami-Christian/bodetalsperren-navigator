{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HarzFishing Catch Event",
  "type": "object",
  "required": ["id", "species", "caughtAt", "source", "confidence"],
  "properties": {
    "id": {"type":"string"},
    "species": {"type":"string"},
    "waterName": {"type":["string","null"]},
    "lavNumber": {"type":["string","null"]},
    "region": {"type":["string","null"]},
    "latitude": {"type":["number","null"]},
    "longitude": {"type":["number","null"]},
    "caughtAt": {"type":"string"},
    "timePrecision": {"enum":["exact","hour","daypart","date"]},
    "lengthCm": {"type":["number","null"]},
    "weightKg": {"type":["number","null"]},
    "method": {"type":["string","null"]},
    "bait": {"type":["string","null"]},
    "source": {
      "type":"object",
      "required":["provider","url","accessMode"],
      "properties": {
        "provider":{"type":"string"},
        "url":{"type":"string"},
        "externalId":{"type":["string","null"]},
        "accessMode":{"enum":["manual","official-api","licensed-import"]}
      }
    },
    "confidence":{"type":"number","minimum":0,"maximum":1},
    "weather":{"type":["object","null"]},
    "notes":{"type":["string","null"]}
  }
}
